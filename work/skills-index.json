        ]
      },
      {
        "name": "delete",
        "input": {
          "state": {
            "keep": 1,
            "remove": 2
          },
          "operation": {
            "action": "delete",
            "key": "remove"
          }
        },
        "stdout_contains": "\"keep\":1",
        "expected_files": [
          "state.json"
        ]
      },
      {
        "name": "batch",
        "input": {
          "state": {
            "n": 1
          },
          "operations": [
            {
              "action": "increment",
              "key": "n",
              "delta": 4
            },
            {
              "action": "set",
              "key": "done",
              "value": true
            }
          ]
        },
        "stdout_contains": "\"n\":5",
        "expected_files": [
          "state.json"
        ]
      }
